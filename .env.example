# Copy to .env and fill in. Never commit .env.

# GitHub: a fine-grained PAT with "Contents: read" and "Pull requests: read & write" on the test repo.
GITHUB_TOKEN=
# Any random string; paste the same value into the webhook's "Secret" field on GitHub.
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# Which AI to use: "gemini" (free tier available) or "anthropic" (Claude, paid).
LLM_PROVIDER=gemini

# Gemini: free key (no card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_TOKENS=32768
GEMINI_MIN_INTERVAL_S=6

# Claude (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_MAX_TOKENS=16000
LLM_REFUSAL_FALLBACK=true

RETRIEVAL_K=5
MAX_CALLERS_PER_FUNCTION=5
MAX_CONTEXT_CHARS=60000

SANDBOX_TIMEOUT_S=180
SANDBOX_MEM_LIMIT=1g
SANDBOX_CPUS=1.0
SANDBOX_INSTALL_DEPS=true
SANDBOX_DIFFERENTIAL=true

MIN_CONFIDENCE_UNVERIFIED=0.8
DRY_RUN=false

# Linux only: group id that owns /var/run/docker.sock (stat -c %g /var/run/docker.sock)
DOCKER_GID=0
